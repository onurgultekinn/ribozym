{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coding_task.schema.json",
  "title": "A5 coding output (§5.10, §11.8): one LLM turn -> file patch set + self-check",
  "type": "object",
  "required": ["schema_version", "task_id", "files", "self_check"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "task_id": { "type": "string", "pattern": "^T[0-9]+$" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "content"],
        "properties": {
          "path": { "type": "string", "pattern": "^(?!\\.\\./)(?!/)[^\\\\]+$" },
          "content": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "notes": { "type": "string" },
    "self_check": {
      "type": "object",
      "required": ["commands"],
      "properties": {
        "commands": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}

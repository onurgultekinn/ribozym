{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spec.schema.json",
  "title": "Spec (A1 output)",
  "type": "object",
  "required": ["schema_version", "id", "version", "created_at", "created_by", "source", "title", "description", "mode", "language", "requirements", "constraints", "acceptance_criteria", "out_of_scope", "budget", "autonomy_level", "approval_required", "compliance_status"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "id": { "type": "string", "pattern": "^spec-[0-9]{8}-[0-9]{3}$" },
    "run_id": { "type": "string", "pattern": "^run-[a-z0-9]+$" },
    "version": { "type": "string" },
    "created_at": { "type": "string", "format": "date-time" },
    "created_by": { "type": "string", "enum": ["A1"] },
    "source": {
      "type": "object",
      "required": ["raw_input_hash", "raw_input_path"],
      "properties": {
        "raw_input_hash": { "type": "string", "pattern": "^sha256:[a-f0-9]{64}$" },
        "raw_input_path": { "type": "string" }
      }
    },
    "title": { "type": "string", "maxLength": 120 },
    "description": { "type": "string" },
    "mode": { "type": "string", "enum": ["greenfield", "brownfield"] },
    "target_path": { "type": ["string", "null"] },
    "language": {
      "type": "object",
      "required": ["primary", "confidence", "source"],
      "properties": {
        "primary": { "type": "string" },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "source": { "type": "string", "enum": ["explicit", "inferred"] }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "text", "priority", "category"],
        "properties": {
          "id": { "type": "string", "pattern": "^R[0-9]+$" },
          "text": { "type": "string" },
          "priority": { "type": "string", "enum": ["must", "should", "could"] },
          "category": { "type": "string", "enum": ["functional", "non_functional", "security", "performance"] }
        }
      }
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text"],
        "properties": {
          "id": { "type": "string", "pattern": "^C[0-9]+$" },
          "text": { "type": "string" }
        }
      }
    },
    "acceptance_criteria": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "text", "verifiable_by", "measurement"],
        "properties": {
          "id": { "type": "string", "pattern": "^AC[0-9]+$" },
          "text": { "type": "string" },
          "verifiable_by": { "type": "string" },
          "measurement": { "type": "string" }
        }
      }
    },
    "out_of_scope": { "type": "array", "items": { "type": "string" } },
    "open_questions": {
      "description": "Unresolved questions at spec time (silent-guess ban, v2.4)",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "question"],
        "properties": {
          "id": { "type": "string" },
          "question": { "type": "string" }
        }
      }
    },
    "assumptions": {
      "description": "Explicit assumptions; audited at FinalReview (v2.4)",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "assumption"],
        "properties": {
          "id": { "type": "string" },
          "assumption": { "type": "string" }
        }
      }
    },
    "decisions": {
      "description": "ADR-format locked decisions incl. technology (v2.6)",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "choice", "alternatives_considered", "rationale", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^D[0-9]+$" },
          "title": { "type": "string" },
          "choice": { "type": "string" },
          "alternatives_considered": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["option", "rejected_because"],
              "properties": {
                "option": { "type": "string" },
                "rejected_because": { "type": "string" }
              }
            }
          },
          "rationale": { "type": "string" },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "mvp_scope": {
      "description": "MVP = form must-items + accepted suggestions (v2.5)",
      "type": "array",
      "items": { "type": "string", "pattern": "^R[0-9]+$" }
    },
    "budget": {
      "type": "object",
      "required": ["max_cost_usd", "max_duration_seconds"],
      "properties": {
        "max_cost_usd": { "type": "number", "exclusiveMinimum": 0 },
        "max_duration_seconds": { "type": "integer", "exclusiveMinimum": 0 }
      }
    },
    "autonomy_level": { "type": "integer", "enum": [1, 2, 3] },
    "approval_required": {
      "type": "array",
      "items": { "type": "string", "enum": ["spec", "task_plan", "delivery", "error"] }
    },
    "compliance_status": { "type": "string", "enum": ["approved", "rejected", "needs_revision"] },
    "compliance_notes": { "type": "array", "items": { "type": "string" } }
  }
}
